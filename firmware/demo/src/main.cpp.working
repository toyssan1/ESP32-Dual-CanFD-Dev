/**
 * 12keypad-to-can.ino
 *
 * ESP32-S3 Button UART → CAN bridge
 * - UART keypad decoder on UART2 (GPIO35 RX, GPIO36 TX)
 * - CAN via ESP32-TWAI-CAN library (v1.0.1) using TWAI peripheral
 * - Optional Web UI config saved to SPIFFS (currently commented out, as in your original)
 *
 * Notes:
 * - Uses ESP32-TWAI-CAN's CanFrame which is an alias of twai_message_t.
 *   Therefore fields are: identifier, data_length_code, extd, rtr, data[]
 * - Adds yield() inside UART processing loop to avoid watchdog resets.
 */

#include <HardwareSerial.h>
#include <WiFi.h>
#include <WebServer.h>
#include <SPIFFS.h>
#include <ArduinoJson.h>
#include <ESP32-TWAI-CAN.hpp>

// -------------------- UART BUTTON DECODER --------------------

HardwareSerial ButtonSerial(2);  // UART2

bool previousButtons[13] = {false}; // index 1..12

// -------------------- CAN (TWAI) CONFIG --------------------
// These are actual GPIO numbers for TWAI TX/RX
static const uint8_t PIN_TWAI_TX = 8;
static const uint8_t PIN_TWAI_RX = 9;

static const uint32_t CAN_SPI_BITRATE  = 1000;  // input bus
static const uint32_t CAN_TWAI_BITRATE = 500;   // output bus

static const uint16_t SRC_ID = 0x2C1;
static const uint16_t DST_ID = 0x148;

static const uint32_t TX_RATE_HZ = 10;
static const uint32_t TX_PERIOD_MS = 1000 / TX_RATE_HZ;

// UART pins (actual GPIO numbers)
// You confirmed your header pins map to GPIO35/GPIO36
#define KEY_RX 35
#define KEY_TX 36

// -------------------- WIFI + WEB CONFIG --------------------

WebServer server(80);

const char* AP_SSID = "ButtonCAN-AP";
const char* AP_PASS = "buttoncan123";

// -------------------- BUTTON → CAN CONFIG --------------------

struct ButtonConfig {
  uint32_t canId;   // CAN ID (e.g. 0x2D1, 0x2D3)
  uint8_t  offset;  // byte offset 0–7
  uint8_t  mask;    // mask byte (currently not applied; stored for future use)
  uint8_t  onVal;   // value to send when "ON"
  uint8_t  offVal;  // value to send when "OFF"
  uint8_t  mode;    // 0=momentary, 1=on/off, 2=fast on/off, 3=slow on/off
  uint16_t frequency; // Hz for non-momentary modes
  bool     resetOnRelease; // for momentary: send OFF/reset on release
};

ButtonConfig buttonCfg[13];  // index 1..12

bool logicalState[13] = {false};
bool blinkEnabled[13] = {false};
uint32_t nextToggleMs[13] = {0};

enum ButtonMode : uint8_t {
  MODE_MOMENTARY = 0,
  MODE_ON_OFF = 1,
  MODE_FAST_ON_OFF = 2,
  MODE_SLOW_ON_OFF = 3
};

// -------------------- CONFIG HELPERS --------------------

CanFrame rxFrame;


static void setupTWAI() {
  ESP32Can.setPins(PIN_TWAI_TX, PIN_TWAI_RX);
  if (ESP32Can.begin(ESP32Can.convertSpeed(CAN_TWAI_BITRATE))) {
    Serial.println("TWAI started @ 500k (TX=GPIO8 RX=GPIO9)");
  } else {
    Serial.println("TWAI FAILED");
    while (true) delay(1000);
  }
}



void setup() {

    Serial.begin(115200);
    delay(1000);
    Serial.println("ESP32S3 CAN-Bus5");

    setupTWAI();
    // // Set the pins
    // ESP32Can.setPins(PIN_TWAI_TX, PIN_TWAI_RX);
 
    // // Start the CAN bus at 500 kbps
    // if(ESP32Can.begin(ESP32Can.convertSpeed(500))) {
    //     Serial.println("CAN bus started!");
    // } else {
    //     Serial.println("CAN bus failed!");
    // }
}


void sendObdFrame(uint8_t obdId) {
    CanFrame obdFrame         = {0};
    obdFrame.identifier       = 0x7DF; // Default OBD2 address;
    obdFrame.extd             = 0;
    obdFrame.data_length_code = 8;
    obdFrame.data[0]          = 2;
    obdFrame.data[1]          = 1;
    obdFrame.data[2]          = obdId;
    obdFrame.data[3]          = 0xAA; // Best use 0xAA (0b10101010) instead of 0
    obdFrame.data[4]          = 0xAA; // TWAI / CAN works better this way, as it
    obdFrame.data[5]          = 0xAA; // needs to avoid bit-stuffing
    obdFrame.data[6]          = 0xAA;
    obdFrame.data[7]          = 0xAA;
    // Accepts both pointers and references
    ESP32Can.writeFrame(obdFrame); // timeout defaults to 1 ms
}

void sendCan(const ButtonConfig& cfg, bool isOn) {
  CanFrame frame = {};                // alias of twai_message_t

  frame.identifier = cfg.canId;       // CAN ID
  frame.extd = 0;                     // 0 = standard 11-bit, 1 = extended 29-bit
  frame.rtr  = 0;                     // not a remote request
  frame.data_length_code = 8;         // always 8 bytes

  uint8_t val = isOn ? cfg.onVal : cfg.offVal;

  // All bytes default to 0
  for (int i = 0; i < 8; i++) frame.data[i] = 0x00;

  if (cfg.offset < 8) {
    frame.data[cfg.offset] = val;
  }

  const bool ok = ESP32Can.writeFrame(frame);

  Serial.printf("BTN → CAN ID=0x%03X off=%u val=0x%02X (%s) ok=%s\n",
                cfg.canId, cfg.offset, val, isOn ? "ON" : "OFF", ok ? "true" : "false");
}


void loop() {
  sendCan(); // call function to recieve data through CAN
  delay(100);
}



